{
  "defaults": {
    "timeoutMs": 30000,
    "hardTimeoutMs": 60000,
    "startRetryDelayMs": 200,
    "warmupTimeoutMs": 5000,
    "startGraceMs": 3000
  },
  "pipeline": [
    { "id": "left", "title": "Left", "agent": "stub", "spec": "Do the left work and write {out}.", "writes": "P1.md" },
    { "id": "right", "title": "Right", "agent": "stub", "parallelWith": "left", "spec": "Do the right work and write {out}.", "writes": "P2.md" },
    { "id": "join", "title": "Join", "agent": "stub", "reads": ["left", "right"], "spec": "Combine {reads} into {out}.", "writes": "P3.md" }
  ]
}
