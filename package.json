{
  "name": "orca-sdlc-kit",
  "version": "0.1.0",
  "description": "Orca SDLC Flow Kit — a pipeline of AI agents inside Orca ADE whose every step lands on disk as verifiable output. This package is only the installer (npx scaffolding); the kit itself is one zero-dependency Node script that stays in your project.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vankhangfet/orca-sdlc-kit.git"
  },
  "bin": {
    "orca-sdlc-kit": "bin/init.mjs"
  },
  "scripts": {
    "test": "node test/run-tests.mjs"
  },
  "files": [
    ".orca/flow.mjs",
    ".orca/agent-config.mjs",
    ".orca/designer.mjs",
    ".orca/designer.html",
    ".orca/flow.config.json",
    ".orca/fixbug.config.json",
    ".orca/cr.config.json",
    ".orca/CONFIGURATION.md",
    ".orca/README.md",
    ".orca/notify.json",
    ".orca/workflow-template/README.md",
    ".orca/workflow-template/sdlc.config.json",
    ".orca/workflow-template/fixbug.config.json",
    ".orca/workflow-template/cr.config.json",
    "orca.yaml",
    "bin/"
  ],
  "engines": {
    "node": ">=18"
  }
}
